---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Our Studies & Research Themes — Human Studies Unit',
};
---

<Layout metadata={metadata}>
  <HeroText
    title="Our Studies"
    subtitle="Explore our comprehensive portfolio of clinical and genomic research studies, categorized by research themes."
  />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Theme 1 -->
    <h2 class="text-3xl font-bold mb-4 font-heading text-heading">Genomics & Precision Health</h2>
    <div class="w-16 h-1 bg-primary mb-8 rounded-full"></div>
    <div class="space-y-8 mb-16">
      <!-- Study 1 -->
      <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800">
        <h3 class="text-2xl font-bold mb-2">Study Name 1 (Placeholder)</h3>
        <p class="text-sm text-secondary dark:text-blue-300 font-semibold mb-4 uppercase tracking-wide">Principal Investigator: Prof. Name Here</p>
        <p class="text-muted dark:text-slate-300 mb-4">Detailed description of the study, its aims, and its methodology.</p>
        <div class="text-sm text-slate-700 dark:text-slate-400">
          <strong>Collaborators:</strong> University Name, Research Institute Name<br/>
          <strong>Key Publications:</strong> <a href="#" class="text-primary hover:underline">Recent Paper Title (2024)</a>
        </div>
      </div>
    </div>

    <!-- Theme 2 -->
    <h2 class="text-3xl font-bold mb-4 font-heading text-heading">Population Health & Chronic Disease</h2>
    <div class="w-16 h-1 bg-primary mb-8 rounded-full"></div>
    <div class="space-y-8 mb-16">
      <!-- Study 2 -->
      <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800">
        <h3 class="text-2xl font-bold mb-2">Study Name 2 (Placeholder)</h3>
        <p class="text-sm text-secondary dark:text-blue-300 font-semibold mb-4 uppercase tracking-wide">Principal Investigator: Dr. Name Here</p>
        <p class="text-muted dark:text-slate-300 mb-4">Detailed description of the study, its aims, and its methodology.</p>
        <div class="text-sm text-slate-700 dark:text-slate-400">
          <strong>Collaborators:</strong> Hospital Name, Network Name<br/>
          <strong>Key Publications:</strong> <a href="#" class="text-primary hover:underline">Recent Paper Title (2023)</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
