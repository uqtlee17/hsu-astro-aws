---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';

import saghaLogo from '~/assets/images/sagha-logo.png';
import bridgeLogo from '~/assets/images/bdg_logo_rotate-scaled.png';
import HSUServices from '~/components/widgets/HSUServices.astro';
import PurposeValues from '~/components/widgets/PurposeValues.astro';
import GroupedStats from '~/components/widgets/GroupedStats.astro';
import PublicationList from '~/components/hsu/PublicationList.astro';
import publications from '~/data/publications.json';


const metadata = {
  title: 'Human Studies Unit (HSU)',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Lab Status Widget ******************* -->
  <Note
    icon=""
    title="<span class='flex items-center gap-2'><span class='relative flex h-3 w-3'><span class='animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75'></span><span class='relative inline-flex rounded-full h-3 w-3 bg-green-500'></span></span> HSU Activity Status - NORMAL</span>"
    description="HSU is fully operational and sample receipt and processing is unaffected."
  />
  <!-- Hero Widget ******************* -->
  <Hero2
    actions={[
      {
        variant: 'primary',
        text: 'Explore HSU Services',
        href: '#services',
      },
      { text: 'Get In Touch', href: '/contact' },
    ]}
    image={{ src: '~/assets/images/AdobeStock_1985941787.jpeg', alt: 'Human Studies Unit Research Laboratory' }}
    bg='<div class="absolute inset-0 bg-gradient-to-b from-blue-50/40 via-white to-transparent dark:from-slate-900/60 dark:via-slate-900 dark:to-transparent"></div>'
  >
    <Fragment slot="title"> Human Studies Unit </Fragment>

    <Fragment slot="subtitle">
      <span class="block mb-2 mt-2 text-xl font-bold text-secondary dark:text-blue-300"
        >Connecting people, samples, data and genomics to advance human research</span
      >
      <p class="text-slate-800 dark:text-slate-200 text-base sm:text-lg leading-relaxed">
        Operating as part of the Program in Complex Trait Genomics (PCTG) at UQ’s Institute for Molecular Bioscience
        (IMB), we combine laboratory and computing expertise to generate high quality genomic data and provide
        innovative data management solutions to advance understanding of common complex diseases.
      </p>
    </Fragment>
  </Hero2>

  <HSUServices />

  <PurposeValues />

  <!-- Grouped Stats Widget ****************** -->
  <GroupedStats
    tagline="OPERATIONAL SCALE & PIPELINE"
    title="Supporting Research Since 2014"
    subtitle="Demonstrating our operational scale, providing extensive support for clinical research, data collection, and long-term biobanking."
    groups={[
      {
        name: 'Cohorts & Participants',
        colorClass: 'text-pink-600 dark:text-pink-400',
        stats: [
          { amount: '56', title: 'Active Projects' },
          { amount: '27,332', title: 'Participant Registrations' },
          { amount: '9', title: 'Clinical Trials' },
        ]
      },
      {
        name: 'Digital Capture',
        colorClass: 'text-amber-500 dark:text-amber-400',
        stats: [
          { amount: '6,367', title: 'Clinical Data' },
          { amount: '8,366', title: 'Self reported online qnr completed' },
          { amount: '8', title: 'Study Websites' },
        ]
      },
      {
        name: 'Laboratory & Bio repository',
        colorClass: 'text-emerald-500 dark:text-emerald-400',
        stats: [
          { amount: '24,641', title: 'Samples Processed' },
          { amount: '22,140', title: 'Genetic Screens' },
          { amount: '174,334', title: 'Tubes Stored' },
        ]
      }
    ]}
  />

  <!-- Featured Research Programs ****************** -->
  <Features2
    title="Featured Research Programs"
    subtitle="HSU supports a diverse portfolio of human research spanning genomics, population health, mental health, chronic disease and emerging areas of biomedical research."
    columns={3}
    classes={{ container: 'max-w-6xl mx-auto px-4 sm:px-6' }}
    items={[
      {
        title: 'BRIDGE',
        description: `<div class="relative w-full h-36 sm:h-40 mb-4 rounded-xl overflow-hidden bg-white dark:bg-slate-800 flex items-center justify-center p-4 border border-slate-100 dark:border-slate-700/50"><span class="absolute top-2.5 right-2.5 z-10 inline-flex items-center gap-1.5 bg-gradient-to-r from-teal-500 to-emerald-500 text-white text-[0.65rem] font-black uppercase tracking-wider px-2.5 py-1 rounded-full shadow-md animate-pulse"><span class="w-1.5 h-1.5 rounded-full bg-white"></span>Recruiting Now</span><img src="${bridgeLogo.src}" class="max-h-full max-w-full object-contain rounded-lg" alt="Australian DNA Bridge Study Logo" /></div>The Australian DNA Bridge Study: Aims to increase representation of individuals of mixed ancestry in genomics and health research.`,
        callToAction: { text: 'View Study', href: 'https://australiandnabridgestudy.org/', variant: 'link', class: 'text-primary font-medium hover:underline flex items-center gap-1' },
      },
      {
        title: 'AGDS_CellO',
        description: `<div class="w-full h-36 sm:h-40 mb-4 rounded-xl overflow-hidden bg-white dark:bg-slate-800 flex items-center justify-center p-2 border border-slate-100 dark:border-slate-700/50"><img src="https://hsu.imb.uq.edu.au/sites/default/files/styles/medium/public/field/image/cello-hsu.jpg?itok=df4SFJgn" class="w-full h-full object-cover rounded-lg" alt="AGDS_CellO" /></div>The Australian Genetics of Depression Study: Understanding anti-depressant response cell-omics.`,
        callToAction: { text: 'View Study', href: 'https://auscello.org/', variant: 'link', class: 'text-primary font-medium hover:underline flex items-center gap-1' },
      },
      {
        title: 'SAGHA',
        description: `<div class="w-full h-36 sm:h-40 mb-4 rounded-xl overflow-hidden bg-white dark:bg-slate-800 flex items-center justify-center p-4 border border-slate-100 dark:border-slate-700/50"><img src="${saghaLogo.src}" class="max-h-full max-w-full object-contain rounded-lg" alt="SAGHA" /></div>South Asian Genes and Health in Australia: Addressing the lack of representation in cardiovascular genetics.`,
        callToAction: { text: 'View Study', href: 'https://saghaus.org/', variant: 'link', class: 'text-primary font-medium hover:underline flex items-center gap-1' },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/60 dark:bg-slate-900"></div>
    </Fragment>
    <div class="flex justify-center mt-6 md:mt-8">
      <Button variant="primary" href="/studies"> View All Studies &rarr; </Button>
    </div>
  </Features2>

  <!-- Featured Publications ******************* -->
  <section class="relative py-10 md:py-14 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-bold font-heading text-heading leading-tight tracking-tight mb-3"
      >
        Featured Publications
      </h2>
      <p class="text-muted dark:text-slate-300 text-sm sm:text-base">
        Highlighting some of our most impactful collaborative research and methodological papers.
      </p>
    </div>

    <PublicationList items={publications} featuredOnly={true} limit={3} variant="compact" />

    <div class="flex justify-center mt-6 md:mt-8">
      <Button variant="primary" href="/publications"> View All Publications &rarr; </Button>
    </div>
  </section>

  <!-- Latest News & Announcements Widget ******* -->
  <BlogLatestPosts
    tagline="LATEST FROM HSU"
    title="News, research and updates"
    information="Stay up to date with the latest research, developments, events and activities from the Human Studies Unit."
    count={3}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/60 dark:bg-slate-900"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Submit a Sample',
        href: '/submit-sample',
        icon: 'tabler:flask',
      },
      {
        variant: 'secondary',
        text: 'Request Supplies',
        href: '/request-supplies',
        icon: 'tabler:box',
      },
    ]}
  >
    <Fragment slot="title"> Need to request supplies or submit a sample? </Fragment>

    <Fragment slot="subtitle"> Start your request or submission here. </Fragment>
  </CallToAction>
</Layout>
