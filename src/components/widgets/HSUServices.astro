---
import Image from '~/components/common/Image.astro';

import card01 from '~/assets/images/card_01.png';
import card02 from '~/assets/images/card_02.png';
import card03 from '~/assets/images/card_03.png';
import card04 from '~/assets/images/card_04.png';

export interface Props {
  id?: string;
  bg?: string;
}

const { id = 'services', bg = 'bg-blue-50/70 dark:bg-slate-900' } = Astro.props;
---

  <!-- HSU SERVICES Section (Mountain Downward Stepped Layout with 6 Cards) ******************* -->
  <section class={`relative ${bg} py-12 md:py-16 overflow-hidden`} id={id}>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Side: 6 Cards in 3 Columns, 2 Rows -->
        <div class="lg:col-span-8 order-2 lg:order-1">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 items-start">
            <!-- 1. Laboratory Services -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card01}
                    alt="Laboratory Services Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Laboratory Services
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  State-of-the-art sample processing, automated DNA/RNA extraction, and stringent quality control.
                </p>
              </div>
            </div>

            <!-- 5. Research Governance -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card02}
                    alt="Research Governance Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Research Governance
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  Expert guidance on HREC ethics applications, dynamic consent, and regulatory compliance.
                </p>
              </div>
            </div>

            <!-- 3. Data Capture & Recruitment -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card02}
                    alt="Data Capture & Participant Recruitment Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Data Capture & Recruitment
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  Nationwide sample kit distribution, digital e-consent workflows, and clinical intake protocols.
                </p>
              </div>
            </div>

            <!-- 2. Research IT Systems -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card03}
                    alt="Research IT Systems Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Research IT Systems
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  Secure participant portals, custom LIMS integration, survey web apps, and automated API data pipelines.
                </p>
              </div>
            </div>

            <!-- 4. Bio-Repository -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card04}
                    alt="Bio-Repository Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Bio-Repository
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  CTRNet-certified cryogenic vapor-phase LN2 biobank tracking 174,000+ specimens with 24/7 telemetry.
                </p>
              </div>
            </div>

            <!-- 6. Data & Biobanking -->
            <div
              class="group bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-md shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-700/50 flex flex-col justify-between text-center transition-all duration-300 hover:-translate-y-1.5"
            >
              <div>
                <div class="w-[70%] mx-auto mb-1 overflow-hidden rounded-2xl flex justify-center">
                  <Image
                    src={card04}
                    alt="Data & Biobanking Illustration"
                    class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <h3 class="text-lg sm:text-xl font-bold font-heading text-heading mb-2">
                  Data & Biobanking
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed">
                  Integrated phenotypic data curation, longitudinal cohort registries, and secure data access.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Title & Description -->
        <div class="lg:col-span-4 order-1 lg:order-2 text-left">
          <p class="text-xs sm:text-sm text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2 block">
            HSU SERVICES
          </p>

          <h2
            class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-heading leading-tight tracking-tight mb-3"
          >
            Supporting research from people to data
          </h2>

          <div class="w-16 h-1 bg-primary mb-4 rounded-full"></div>

          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed mb-6">
            HSU brings together laboratory science, genomics, research data, and clinical expertise to support studies across the entire research lifecycle.
          </p>

          <a
            href="/services"
            class="inline-flex items-center justify-center bg-primary hover:bg-secondary text-white font-bold px-7 py-3 rounded-full text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all duration-300 hover:scale-105"
          >
            Explore All Services &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
