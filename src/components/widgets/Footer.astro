---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer
  class:list={[
    { dark: theme === 'dark' },
    'relative bg-[#082c5c] dark:bg-[#061e3f] text-white border-t-4 border-t-primary not-prose',
  ]}
>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="grid grid-cols-12 gap-8 py-10 md:py-14">
      <!-- Site & UQ Logo Branding -->
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-4">
          <div class="flex flex-col gap-4 items-start">
            <div class="text-primary leading-tight font-bold text-xl">
              {SITE?.name}<br />
              <span class="text-sm font-normal text-blue-100"
                >Institute for Molecular Bioscience,<br />The University of Queensland</span
              >
            </div>
            <img src="https://www.drupal.org/files/uq.png" alt="UQ Logo" class="h-16 md:h-20 w-auto object-contain" />
          </div>
        </div>
      </div>

      <!-- Navigation Columns (Contact & Quick Links) -->
      {
        links.map(({ title, links }) => (
          <div class={title === 'Contact' ? "col-span-12 sm:col-span-6 lg:col-span-3" : "col-span-12 sm:col-span-6 lg:col-span-2"}>
            <div class="text-primary font-bold text-lg mb-3 tracking-wide">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-2 text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    {href ? (
                      <a
                        class="text-slate-200 hover:text-primary hover:underline transition duration-150 ease-in-out"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    ) : (
                      <span class="text-slate-200">
                        <Fragment set:html={text} />
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      <!-- Accreditations & Support -->
      <div class="col-span-12 lg:col-span-3 flex flex-col items-start justify-start space-y-6 lg:ml-auto">
        <div class="flex items-center gap-3">
          <img src="https://www.ctrnet.ca/wp-content/uploads/2020/01/CTRNet_Tissue_logo-e1578946130687.png" alt="CTRNet Certified" class="h-10 md:h-12 object-contain bg-white rounded-md p-1 shadow-sm" />
          <span class="text-xs text-slate-300 font-medium">CTRNet Biobank<br />Certification: 2023</span>
        </div>
        <div class="flex items-center gap-3">
          <img src="https://hdsunflower.com/media/pixiemedia/media/1731410479_PROUD-To-SUPPORT-UK_2.png" alt="Hidden Disabilities" class="h-10 md:h-12 object-contain bg-white rounded-md p-1 shadow-sm" />
          <span class="text-xs text-slate-300 font-medium">Proudly supporting<br />Hidden Disabilities</span>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div class="border-t border-blue-900/60 dark:border-slate-800 md:flex md:items-center md:justify-between py-6">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-slate-300 hover:text-white hover:bg-blue-900/50 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 text-slate-300 flex flex-wrap items-center gap-2">
        <Fragment set:html={footNote} />
        {
          secondaryLinks.map(({ text, href }) => (
            <>
              <span>·</span>
              <a
                class="text-slate-300 hover:text-primary hover:underline transition duration-150 ease-in-out"
                href={href}
                set:html={text}
              />
            </>
          ))
        }
      </div>
    </div>
  </div>
</footer>
