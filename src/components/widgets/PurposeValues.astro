---
import { Icon } from 'astro-icon/components';

export interface Props {
  id?: string;
  bg?: string;
}

const { id = 'purpose-values', bg = 'bg-white dark:bg-slate-900' } = Astro.props;
---

<!-- Purpose & Core Values Section ******************* -->
<section class={`relative ${bg} py-10 md:py-14`} id={id}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <p class="text-xs sm:text-sm text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        FOUNDATIONAL PRINCIPLES
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-heading text-heading leading-tight tracking-tight">
        Our Purpose & Core Values
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mt-3 rounded-full"></div>
      <p class="mt-4 text-sm sm:text-base text-muted dark:text-slate-300">
        We drive precision health innovation through robust infrastructure, uncompromising scientific integrity, and a commitment to ethically governed, multi-ancestry research.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Card 1: Mission -->
      <div
        class="group bg-blue-50/40 dark:bg-slate-800 rounded-3xl p-6 sm:p-7 shadow-md shadow-slate-100/50 dark:shadow-none border border-blue-100/80 dark:border-slate-700/50 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg"
      >
        <div
          class="w-12 h-12 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 text-white flex items-center justify-center mb-5 text-xl font-bold shadow-sm"
        >
          <Icon name="tabler:target-arrow" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold font-heading text-heading mb-3">Our Mission</h3>
        <p class="text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
          To deliver seamless, high-integrity laboratory and computational workflows that turn biological samples into
          accessible, high-quality genomic data while protecting participant trust.
        </p>
      </div>

      <!-- Card 2: Vision -->
      <div
        class="group bg-blue-50/40 dark:bg-slate-800 rounded-3xl p-6 sm:p-7 shadow-md shadow-slate-100/50 dark:shadow-none border border-blue-100/80 dark:border-slate-700/50 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg"
      >
        <div
          class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white flex items-center justify-center mb-5 text-xl font-bold shadow-sm"
        >
          <Icon name="tabler:eye" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold font-heading text-heading mb-3">Our Vision</h3>
        <p class="text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
          To empower breakthrough precision health research globally by establishing Australia’s most trusted,
          scalable, and ethically governed human research infrastructure.
        </p>
      </div>

      <!-- Card 3: Values -->
      <div
        class="group bg-blue-50/40 dark:bg-slate-800 rounded-3xl p-6 sm:p-7 shadow-md shadow-slate-100/50 dark:shadow-none border border-blue-100/80 dark:border-slate-700/50 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg"
      >
        <div
          class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 text-white flex items-center justify-center mb-5 text-xl font-bold shadow-sm"
        >
          <Icon name="tabler:shield-check" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold font-heading text-heading mb-3">Scientific Integrity</h3>
        <p class="text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
          Upholding strict quality control standards, transparent data management, participant privacy, and
          multi-ancestry inclusivity across every study we support.
        </p>
      </div>
    </div>
  </div>
</section>
