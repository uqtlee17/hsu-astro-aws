---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg,
} = Astro.props;

const hasBgSlot = Astro.slots.has('bg');
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    {hasBgSlot ? <slot name="bg" /> : bg ? <Fragment set:html={bg} /> : null}
  </div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-10 md:py-12 lg:flex lg:items-center lg:gap-8">
      <div class="basis-1/2 text-center lg:text-left mx-auto">
        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto lg:max-w-none">
          {
            subtitle && (
              <p
                class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="mt-6 md:mt-8 max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 lg:justify-start lg:m-0 lg:max-w-7xl intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class:list={[
          'basis-1/2 mt-6 lg:mt-0 flex items-center justify-center',
          {
            'opacity-0 pointer-events-none hidden lg:flex':
              typeof image === 'object' && image !== null && 'class' in image && String(image.class).includes('opacity-0'),
          },
        ]}
      >
        {
          image && (
            <div class="relative w-full max-w-lg lg:max-w-none h-full max-h-[340px] sm:max-h-[380px] md:max-h-[400px] rounded-3xl overflow-hidden shadow-lg shadow-blue-100/50 dark:shadow-none border border-slate-200/80 dark:border-slate-700/60 intersect-once intersect-no-queue motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter flex items-center justify-center">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="w-full h-full object-cover object-center rounded-3xl transition-transform duration-500 hover:scale-105"
                  layout="cover"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  format="webp"
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
  <slot name="curve" />
</section>
