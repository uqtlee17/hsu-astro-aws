---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface StatItem {
  title: string;
  amount: string;
}

export interface StatGroup {
  name: string;
  colorClass: string;
  stats: StatItem[];
}

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  groups: StatGroup[];
  id?: string;
  isDark?: boolean;
  classes?: Record<string, string>;
  bg?: string;
}

const {
  tagline = '',
  title = '',
  subtitle = '',
  groups = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  {(title || subtitle || tagline) && (
    <div class="mb-10 md:mx-auto text-center max-w-3xl">
      {tagline && (
        <p class="text-xs sm:text-sm text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
          {tagline}
        </p>
      )}
      {title && (
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-heading text-heading leading-tight tracking-tight mb-3">
          {title}
        </h2>
      )}
      {subtitle && <p class="text-muted dark:text-slate-300 text-sm sm:text-base">{subtitle}</p>}
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
    {groups.map((group) => (
      <div class="flex flex-col">
        <h3 class="text-base sm:text-lg font-bold font-heading mb-6 tracking-widest text-center text-slate-800 dark:text-slate-200">
          {group.name}
        </h3>
        <div class="flex flex-col gap-6">
          {group.stats.map((stat, index) => (
            <div class="flex flex-col items-center">
              <div class={`stat-counter text-3xl font-bold font-heading tracking-tight mb-1 ${group.colorClass}`}>
                {stat.amount}
              </div>
              <div class="text-[0.7rem] sm:text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider text-center">
                {stat.title}
              </div>
              {index < group.stats.length - 1 && (
                <div class="w-full h-px bg-slate-100 dark:bg-slate-700 mt-6 mx-auto"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script>
  function animateValue(obj: HTMLElement, start: number, end: number, duration: number) {
    let startTimestamp: number | null = null;
    const formatNumber = (num: number) => num.toLocaleString('en-US');
    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      
      // easeOutQuart for smooth deceleration
      const easeOut = 1 - Math.pow(1 - progress, 4);
      const current = Math.floor(easeOut * (end - start) + start);
      
      obj.innerHTML = formatNumber(current);
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        obj.innerHTML = formatNumber(end);
      }
    };
    window.requestAnimationFrame(step);
  }

  const initCounters = () => {
    const counters = document.querySelectorAll('.stat-counter:not(.counted)');
    
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const text = el.innerText.trim();
            // Parse the number, ignoring commas
            const target = parseInt(text.replace(/,/g, ''), 10);
            
            if (!isNaN(target)) {
              el.innerText = '0';
              el.classList.add('counted');
              animateValue(el, 0, target, 2500);
            }
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.1 }
    );

    counters.forEach(counter => observer.observe(counter));
  };

  // Run on initial load and after view transitions
  document.addEventListener('astro:page-load', initCounters);
</script>
