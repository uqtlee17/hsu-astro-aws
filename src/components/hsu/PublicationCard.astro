---
export interface Publication {
  id?: string;
  title: string;
  authors: string;
  journal: string;
  year: number;
  doi: string;
  tags: string[];
  abstract?: string;
  isFeatured?: boolean;
}

interface Props {
  pub: Publication;
  variant?: 'full' | 'compact';
}

const { pub, variant = 'full' } = Astro.props;
---

{
  variant === 'compact' ? (
    <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 hover:shadow-lg transition-all duration-300">
      <h4 class="text-lg font-bold mb-2 leading-tight">
        <a
          href={`https://doi.org/${pub.doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors"
        >
          {pub.title}
        </a>
      </h4>
      <p class="text-muted text-sm mb-3">{pub.authors}</p>
      <div class="flex items-center justify-between text-xs font-semibold">
        <span class="text-secondary dark:text-blue-400">
          {pub.journal} ({pub.year})
        </span>
        <a
          href={`https://doi.org/${pub.doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline"
        >
          View DOI &rarr;
        </a>
      </div>
    </div>
  ) : (
    <li
      class="pub-item p-6 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 hover:shadow-lg transition-shadow duration-300"
      data-tags={pub.tags.join(',')}
    >
      <h4 class="text-lg md:text-xl font-bold mb-2 leading-tight">
        <a
          href={`https://doi.org/${pub.doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors"
        >
          {pub.title}
        </a>
      </h4>
      <p class="text-muted mb-3 text-sm md:text-base">{pub.authors}</p>

      <div class="flex flex-wrap items-center gap-4 text-sm mb-4">
        <span class="font-semibold text-secondary dark:text-blue-400">{pub.journal}</span>
        <span class="hidden md:inline text-slate-300 dark:text-slate-600">|</span>
        <a
          href={`https://doi.org/${pub.doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-primary break-all"
        >
          DOI: {pub.doi}
        </a>
      </div>

      <div class="flex flex-wrap gap-2">
        {pub.tags.map((tag) => (
          <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-xs font-semibold rounded-md uppercase tracking-wider">
            {tag}
          </span>
        ))}
      </div>
    </li>
  )
}
